{
  "name": "fcg-sonic-guidelines",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Foery Creative Group — internal tool for drafting sonic branding production guidelines",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "server": "tsx watch server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "dompurify": "^3.2.4",
    "express": "^4.21.2",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
